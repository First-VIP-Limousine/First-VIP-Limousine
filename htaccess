# Aktivierung von Rewrite-Engine
RewriteEngine On

# Weiterleitung von non-www zu www
RewriteCond %{HTTP_HOST} ^zuerich-airport-vip-first-service.com [NC]
RewriteRule ^(.*)$ https://www.zuerich-airport-vip-first-service.com/$1 [L,R=301]

# HTTPS-Weiterleitung
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Verzeichnis-Browsing deaktivieren
Options -Indexes

# Kanonische URL festlegen (optional)
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_HOST} !^www\.zuerich-airport-vip-first-service\.com$ [NC]
  RewriteRule ^(.*)$ https://www.zuerich-airport-vip-first-service.com/$1 [L,R=301]
</IfModule>

# Caching für bessere Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Schutz vor Zugriff auf sensible Dateien
<FilesMatch "\.(htaccess|htpasswd|config|ini|log|sh|sql|bak|psd|php)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>
